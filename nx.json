{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "e2e": {
      "cache": true
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/nest",
      "options": {
        "main": "apps/moringa-backend/src/main.ts",
        "tsConfig": "apps/moringa-backend/tsconfig.app.json",
        "test": "apps/moringa-backend/jest.config.ts"
      }
    },
    {
      "plugin": "qwik-nx",
      "options": {
        "main": "apps/moringa-frontend/src/entry.ssr.tsx",
        "tsConfig": "apps/moringa-frontend/tsconfig.app.json"
      }
    }
  ]
}
