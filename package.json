{
  "name": "moringa-ecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Moringa E-Commerce Monorepo - Qwik City frontend + NestJS backend with Nestia and Fastify",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --all --parallel",
    "dev:frontend": "nx run moringa-frontend:dev",
    "dev:backend": "nx run moringa-backend:dev",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx run-many --target=format --all",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint"
  },
  "devDependencies": {
    "@nx/eslint": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/workspace": "23.1.1",
    "eslint": "^9.39.5",
    "nx": "23.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.15.0",
  "dependencies": {
    "@fastify/static": "^8.3.0"
  }
}
