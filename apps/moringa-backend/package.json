{
  "name": "@moringa/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Moringa E-Commerce Backend API built with NestJS, Nestia, and Prisma",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dist-aliases.cjs",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "format": "prettier --write \"src/**/*.ts\"",
    "generate:sdk": "TTSC_TSGO_BINARY=\"$(pwd)/../../node_modules/typescript/bin/tsc\" nestia sdk --project tsconfig.nestia.json && TTSC_TSGO_BINARY=\"$(pwd)/../../node_modules/typescript/bin/tsc\" nestia swagger --project tsconfig.nestia.json",
    "test:boot": "node scripts/smoke-boot.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-fastify": "^11.0.2",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/nodemailer": "^8.0.1",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "geoip-lite": "^2.0.3",
    "handlebars": "^4.7.9",
    "ioredis": "^5.10.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "svg-captcha": "^1.4.0",
    "uuid": "^9.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.5.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "prisma": "7.9.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
