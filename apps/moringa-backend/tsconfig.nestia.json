{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "paths": {
      "@moringa/shared/*": ["../../libs/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "nestia.config.ts"]
}
