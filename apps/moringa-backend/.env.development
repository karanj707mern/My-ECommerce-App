# =============================================================================
# Moringa Backend — DEVELOPMENT environment
# Safe local defaults are pre-filled; fill in the keys marked <FILL ME>.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://moringa:moringa@localhost:5432/moringa

# --- Redis / cache -----------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=

# --- RabbitMQ (leave RABBITMQ_URL empty to run without a broker) -------------
RABBITMQ_URL=
# Alternative: assemble the URL from parts instead of RABBITMQ_URL
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# --- Auth / crypto -----------------------------------------------------------
JWT_SECRET=<FILL ME: long random string>
ENCRYPTION_KEY=<FILL ME: 32+ char random string>
GOOGLE_CLIENT_ID=

# --- URLs / CORS -------------------------------------------------------------
SITE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
API_PUBLIC_URL=http://localhost:5000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting / payload -------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
MAX_BODY_SIZE=1048576

# --- Storage (local | cloudinary | r2) ---------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOADS_PATH=./uploads
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=
STORAGE_CLOUDINARY_UPLOAD_PRESET=
STORAGE_CLOUDINARY_FOLDER=
STORAGE_CLOUDINARY_PUBLIC_URL=
STORAGE_R2_ENDPOINT=
STORAGE_R2_REGION=
STORAGE_R2_BUCKET=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_PUBLIC_URL=

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Moringa <no-reply@moringa.local>

# --- Payments (Razorpay) ------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- Notifications -----------------------------------------------------------
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INTERVAL_MS=60000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
