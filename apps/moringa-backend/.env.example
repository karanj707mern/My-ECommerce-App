# =============================================================================
# Moringa Backend — environment template
#
# Copy to .env.development / .env.production and fill in real values.
# NEVER commit filled env files: .env* is gitignored by design.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# PostgreSQL connection string (postgres://user:pass@host:5432/db)
DATABASE_URL=

# --- Redis / cache -----------------------------------------------------------
# Leave empty to run without Redis (cache degrades to pass-through)
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=300

# --- RabbitMQ ----------------------------------------------------------------
# Leave empty to run without a broker (event fan-out degrades gracefully)
RABBITMQ_URL=
# Alternative: assemble the URL from parts instead of RABBITMQ_URL
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# --- Auth / crypto -----------------------------------------------------------
# 32+ char random strings. Generate: openssl rand -hex 32
JWT_SECRET=<FILL_ME>
ENCRYPTION_KEY=<FILL_ME>

# --- OAuth -------------------------------------------------------------------
# Google Identity Services client ID (audience binding for /auth/google)
GOOGLE_CLIENT_ID=

# --- URLs / CORS -------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
APP_URL=http://localhost:5173
SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000/api/v1
CORS_ORIGINS=http://localhost:5173

# --- HTTP limits -------------------------------------------------------------
MAX_BODY_SIZE=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# --- Payments (Razorpay) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- Storage -----------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOADS_PATH=./uploads
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=
STORAGE_CLOUDINARY_UPLOAD_PRESET=
STORAGE_CLOUDINARY_FOLDER=moringa-store
STORAGE_CLOUDINARY_PUBLIC_URL=

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# --- SMS / WhatsApp ----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Notifications pipeline --------------------------------------------------
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INTERVAL_MS=60000
