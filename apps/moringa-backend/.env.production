# =============================================================================
# Moringa Backend — PRODUCTION environment
# Fill every value before deploying (Render blueprint injects some of these
# automatically: DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY, RAZORPAY_WEBHOOK_SECRET,
# REDIS_URL, RABBITMQ_URL, FRONTEND_URL, RAZORPAY_* — see render.yaml).
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=production
PORT=5000
DATABASE_URL=

# --- Redis / cache (cloud provider connection string) ------------------------
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=

# --- RabbitMQ (cloud broker connection string) -------------------------------
RABBITMQ_URL=
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=/

# --- Auth / crypto -----------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=

# --- URLs / CORS -------------------------------------------------------------
SITE_URL=
FRONTEND_URL=
BACKEND_URL=
API_PUBLIC_URL=
APP_URL=
CORS_ORIGINS=

# --- Rate limiting / payload -------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
MAX_BODY_SIZE=1048576

# --- Storage (local | cloudinary | r2) ---------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOADS_PATH=/app/uploads
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=
STORAGE_CLOUDINARY_UPLOAD_PRESET=
STORAGE_CLOUDINARY_FOLDER=
STORAGE_CLOUDINARY_PUBLIC_URL=
STORAGE_R2_ENDPOINT=
STORAGE_R2_REGION=
STORAGE_R2_BUCKET=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_PUBLIC_URL=

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Payments (Razorpay) ------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- Notifications -----------------------------------------------------------
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INTERVAL_MS=60000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
