{
  "name": "@moringa/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Moringa E-Commerce Frontend built with Qwik City and Tailwind CSS",
  "scripts": {
    "build": "qwik build",
    "build:client": "qwik build",
    "build:server": "qwik build --server",
    "dev": "qwik dev",
    "dev:ssr": "qwik dev --port 5173",
    "fmt": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss}\"",
    "lint": "eslint \"src/**/*.ts*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "preview": "qwik build --mode ssg && qwik preview",
    "start": "node server",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@moringa/shared": "*",
    "@vercel/speed-insights": "^2.0.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "undici": "^7.0.0",
    "vite": "^6.0.0"
  }
}
