{
  "name": "@moringa/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Moringa E-Commerce Frontend built with Qwik City and Tailwind CSS",
  "scripts": {
    "build": "qwik build",
    "build:client": "qwik build",
    "build:server": "qwik build --server",
    "build.client": "vite build",
    "dev": "vite --mode ssr",
    "dev:ssr": "vite --mode ssr --port 5173",
    "fmt": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss}\"",
    "lint": "eslint \"src/**/*.ts*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "preview": "qwik build --mode ssg && qwik preview",
    "start": "node server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:watch": "vitest",
    "smoke": "vite build --ssr scripts/entry.smoke.tsx --outDir dist/smoke --emptyOutDir && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@moringa/sdk": "*",
    "@moringa/shared": "*",
    "@nestia/fetcher": "^13.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "undici": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
