{
  /**
   * Compatibility shim.
   *
   * The canonical configuration now lives in `./tsconfig.json` (NodeNext).
   * Tooling that still references `tsconfig.app.json` (Nx inference caches,
   * editor plugins, historical scripts) resolves through this file, which
   * simply re-exposes the app sources under the canonical compiler options.
   */
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "server", "tmp"]
}
