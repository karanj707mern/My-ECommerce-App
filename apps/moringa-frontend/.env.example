# =============================================================================
# Moringa Frontend (Qwik) — environment template
#
# Copy to .env.development / .env.production and fill in real values.
# All variables are statically replaced by Vite at build time via src/lib/env.ts
# (the only file allowed to touch import.meta.env).
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Canonical public origin of THIS frontend (SSR links, SEO tags)
VITE_SITE_URL=http://localhost:5173

# Cloudinary public cloud name (client-side image delivery)
VITE_CLOUDINARY_CLOUD_NAME=

# Google Identity Services client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
