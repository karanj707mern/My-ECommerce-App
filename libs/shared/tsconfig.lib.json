{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "../../dist/tsconfig.lib.tsbuildinfo",
    "module": "esnext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "strict": true,
    "noEmit": false,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}